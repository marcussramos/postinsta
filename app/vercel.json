{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/upload.js": {
      "maxDuration": 30
    },
    "api/ai/caption.js": {
      "maxDuration": 60
    },
    "api/pasta.js": {
      "maxDuration": 60
    },
    "api/page.js": {
      "includeFiles": "pages/*.html"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(aprovar|relatorio|contrato|cliente|historico|proposta|boasvindas|conectar)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/equipe.html"
    },
    {
      "source": "/aprovar",
      "destination": "/api/page?p=aprovar"
    },
    {
      "source": "/cliente",
      "destination": "/api/page?p=cliente"
    },
    {
      "source": "/relatorio",
      "destination": "/api/page?p=relatorio"
    },
    {
      "source": "/proposta",
      "destination": "/api/page?p=proposta"
    },
    {
      "source": "/historico",
      "destination": "/api/page?p=historico"
    },
    {
      "source": "/boasvindas",
      "destination": "/api/page?p=boasvindas"
    },
    {
      "source": "/diagnostico",
      "destination": "/api/page?p=diagnostico"
    },
    {
      "source": "/privacidade",
      "destination": "/api/page?p=privacidade"
    },
    {
      "source": "/privacy",
      "destination": "/api/page?p=privacidade"
    },
    {
      "source": "/exclusao-de-dados",
      "destination": "/api/page?p=exclusao"
    },
    {
      "source": "/data-deletion",
      "destination": "/api/page?p=exclusao"
    },
    {
      "source": "/exclusao",
      "destination": "/api/page?p=exclusao"
    },
    {
      "source": "/conectar",
      "destination": "/api/page?p=conectar"
    },
    {
      "source": "/termos",
      "destination": "/api/page?p=termos"
    },
    {
      "source": "/terms",
      "destination": "/api/page?p=termos"
    },
    {
      "source": "/sobre",
      "destination": "/api/page?p=sobre"
    },
    {
      "source": "/inicio",
      "destination": "/api/page?p=inicio"
    }
  ]
}
